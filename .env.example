# Copie para .env (cp .env.example .env). Valores para desenvolvimento local.
# Em produção (k3s) estas variáveis vêm do Deployment e de um Secret.

# Valor do header X-Api-Key. Produção: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHAVE_API=dev-chave-local-troque-em-producao
# Chave antiga, aceita durante a rotação; remova depois
# CHAVE_API_ANTERIOR=

# PostgreSQL do app (triagem, votos e decisão). Local: o Postgres de teste.
DB_URL=jdbc:postgresql://localhost:55432/postgres
DB_USER=postgres
DB_PASSWORD=teste

# Hosts de onde o serviço aceita baixar fotos, separados por vírgula (anti-SSRF).
# Local: localhost (python -m http.server). Produção: o host do storage onde o app salva as fotos.
HOSTS_PERMITIDOS=localhost

# Pasta com vision_model.onnx, text_model.onnx e tokenizer.json (ver README)
CLIP_DIR=modelos/clip-vit-base-patch32

LIMIAR_CONFIANCA=0.5
# Opcionais: zona de revisão humana e limiar por categoria (rode a calibração antes de escolher)
# LIMIAR_REVISAO=0.3
# LIMIARES_POR_CATEGORIA={"vidro": 0.6}
# Vazão: pedidos em andamento antes de a API responder 503
# MAX_PEDIDOS_SIMULTANEOS=8
# Cabeça treinada (./gradlew treinarCabeca); só ligue se vencer o zero-shot
# CABECA_TREINADA=cabeca.json
TAMANHO_MAXIMO_BYTES=10000000
TIMEOUT_DOWNLOAD_SEGUNDOS=10

# Fechamento das janelas de 24h (job dentro da API)
# FECHAMENTO_HABILITADO=true

# Segunda opinião (opcional; custa uma chamada paga por foto na zona de revisão)
# SEGUNDA_OPINIAO_ATIVA=false
# SEGUNDA_OPINIAO_URL_BASE=https://api.openai.com/v1
# SEGUNDA_OPINIAO_CHAVE=
# SEGUNDA_OPINIAO_MODELO=gpt-4o-mini
